        <mxCell id="nxtHazRDxtI8mmleK9Jx-30" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;gradientColor=none;" value="A" vertex="1">
          <mxGeometry height="40" width="49" x="1338" y="653" as="geometry" />
