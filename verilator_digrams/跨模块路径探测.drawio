        <mxCell id="W10XeCtAb67ayl2oxKC8-111" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#000000;" value="示例EM Step范围：&lt;br&gt;Em0: [100, 104];&amp;nbsp;EM1: [101, 105]; Em2: [102, 106];&amp;nbsp;Em3: [103, 107];&lt;br&gt;&lt;br&gt;起始EP使整体MinStep++&lt;br&gt;Em0: [101, 104];&amp;nbsp;EM1: [102, 105];&amp;nbsp;Em2: [103, 106];&amp;nbsp;Em3: [104, 107];&lt;br&gt;&lt;br&gt;目的EP使整体MaxStep--&lt;br&gt;Em0: [101, 103];&amp;nbsp;EM1: [102, 104];&amp;nbsp;Em2: [103, 105];&amp;nbsp;Em3: [104, 106];&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;瓶颈路段：Em1-&amp;gt;Em2跨模块路由" vertex="1">
